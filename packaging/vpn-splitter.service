[Unit]
Description=VPN Splitter isolated application network service
After=network.target

[Service]
Type=simple
User=root
Group=vpn-splitter
ExecStart=/usr/bin/python3 -I /usr/lib/vpn-splitter/entry.py service
RuntimeDirectory=vpn-splitter
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
Restart=on-failure
RestartSec=2
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
