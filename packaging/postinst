#!/bin/sh
set -e
if [ "$1" = configure ]; then
    if ! getent group vpn-splitter >/dev/null; then
        addgroup --system vpn-splitter
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable vpn-splitter.service
        systemctl restart vpn-splitter.service
    fi
fi
